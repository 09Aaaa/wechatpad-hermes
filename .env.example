# WeChatPadProMAX
WECHATPAD_BASE_URL=http://127.0.0.1:8062/api
# Put real authcodes and keys only in the runtime env file, never in git/docs/chat.
WECHATPAD_AUTHCODE=
# Server-side only. MCP/Hermes callers never pass this key directly.
WECHATPAD_ADMIN_KEY=
WECHATPAD_BOT_WXID=
WECHATPAD_BOT_NAMES=BOT,机器人

# Hermes / main model endpoint.
# Prefer HERMES_WEBHOOK_URL if Hermes exposes a native message endpoint.
# Otherwise use OpenAI-compatible chat completions.
HERMES_WEBHOOK_URL=
HERMES_CHAT_COMPLETIONS_URL=http://127.0.0.1:9119/v1/chat/completions
HERMES_API_KEY=
HERMES_MODEL=

# Bridge behavior
WECHATPAD_DB_PATH=/opt/hermes/data/wechatpad-hermes/wechatpad-hermes.sqlite3
WECHATPAD_POLICY_PATH=/opt/hermes/data/wechatpad-hermes/policy.yaml
WECHATPAD_POLL_INTERVAL=2.0
WECHATPAD_HISTORY_DAYS=3
WECHATPAD_RETENTION_DAYS=14
WECHATPAD_CONTEXT_TOKEN_TTL_SECONDS=1800
WECHATPAD_MAX_CONTEXT_MESSAGES=80
WECHATPAD_MAX_CONTEXT_CHARS=12000
WECHATPAD_SEND_ENABLED=false
WECHATPAD_DRY_RUN=true
WECHATPAD_ADMIN_TOOLS_ENABLED=false
WECHATPAD_ALLOW_UNKNOWN_OUTBOUND=false
WECHATPAD_STORE_RAW_MESSAGES=false

# Permissions. Keep owner/admin identities explicit.
WECHATPAD_OWNER_WXIDS=
WECHATPAD_ALLOW_ALL_PRIVATE=true
WECHATPAD_ALLOW_ALL_GROUPS=true
WECHATPAD_ALLOWED_PRIVATE_WXIDS=
WECHATPAD_ALLOWED_GROUP_CHATROOMS=
WECHATPAD_BLOCKED_WXIDS=
WECHATPAD_BLOCKED_GROUP_CHATROOMS=
